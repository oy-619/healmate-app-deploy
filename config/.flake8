[flake8]
# 最大行長
max-line-length = 88

# 無視するエラーコード（空白関連を含む）
# E111-E133: インデント関連、W291-W293: 空白関連、E203: スライスの空白、W503: 二項演算子の前の改行
# E501: 行長制限、C901: 複雑度、W391: ファイル末尾の空行
ignore = E203,W503,E501,E111,E114,E115,E116,E117,E121,E122,E123,E124,E125,E126,E127,E128,E129,E131,E133,W291,W292,W293,W391,C901

# 検査対象ディレクトリとファイル
include = src/**/*.py,tests/**/*.py,*.py

# 除外するファイル・ディレクトリ
exclude = .git,__pycache__,env,.env,.venv,venv,build,dist,*.egg-info,.vscode,.pytest_cache,data,docs,config

# 検査対象ファイルパターン
filename = *.py

# 複雑度チェック（無効化）
max-complexity = 999

# 並列処理でのチェック（パフォーマンス向上）
jobs = auto

# 統計情報の表示
statistics = True
count = True
